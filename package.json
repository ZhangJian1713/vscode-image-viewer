{
  "name": "image-viewer",
  "publisher": "vscode-infra",
  "displayName": "Image Viewer",
  "description": "A replacement for VS Code's default image viewer with zoom, pan, rotation, flip, and same-folder navigation. Includes a fast workspace gallery with folder search, filters, and Grid/Fill/List layouts.",
  "icon": "assets/logo.png",
  "version": "2.3.0",
  "author": "Zhang Jian <zhangjian1713@gmail.com>",
  "homepage": "https://github.com/ZhangJian1713/vscode-image-viewer",
  "license": "MIT",
  "engines": {
    "vscode": "^1.92.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "image",
    "image viewer",
    "image preview",
    "default image viewer",
    "photo viewer",
    "image gallery",
    "gallery",
    "thumbnail",
    "preview",
    "custom-editor",
    "default-editor",
    "zoom",
    "pan",
    "rotate",
    "flip",
    "minimap",
    "folder",
    "search",
    "filter",
    "svg",
    "png",
    "jpg",
    "webp",
    "gif",
    "avif"
  ],
  "main": "./dist/extension.js",
  "webviewVendorTemplate": "antd-less",
  "contributes": {
    "commands": [
      {
        "command": "vscode-infra.webviewImageViewer",
        "title": "%command.viewImages%"
      },
      {
        "command": "vscode-infra.setAsDefaultImageViewer",
        "title": "%command.setDefault%",
        "category": "Image Viewer"
      },
      {
        "command": "vscode-infra.restoreBuiltInImageViewer",
        "title": "%command.restoreDefault%",
        "category": "Image Viewer"
      },
      {
        "command": "vscode-infra.cleanWebviewImageCache",
        "title": "%command.cleanCache%",
        "category": "Image Viewer"
      }
    ],
    "customEditors": [
      {
        "viewType": "vscode-infra.imageViewer",
        "displayName": "Image Viewer",
        "selector": [
          {
            "filenamePattern": "*.svg"
          },
          {
            "filenamePattern": "*.png"
          },
          {
            "filenamePattern": "*.jpeg"
          },
          {
            "filenamePattern": "*.jpg"
          },
          {
            "filenamePattern": "*.ico"
          },
          {
            "filenamePattern": "*.gif"
          },
          {
            "filenamePattern": "*.webp"
          },
          {
            "filenamePattern": "*.bmp"
          },
          {
            "filenamePattern": "*.tif"
          },
          {
            "filenamePattern": "*.tiff"
          },
          {
            "filenamePattern": "*.apng"
          },
          {
            "filenamePattern": "*.avif"
          }
        ],
        "priority": "option"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "when": "editorFocus",
          "command": "vscode-infra.webviewImageViewer",
          "group": "z_commands"
        }
      ],
      "explorer/context": [
        {
          "command": "vscode-infra.webviewImageViewer",
          "group": "z_commands"
        }
      ]
    },
    "configuration": {
      "title": "Image Viewer",
      "properties": {
        "imageViewer.showMirrorButtons": {
          "type": "boolean",
          "default": false,
          "scope": "application",
          "description": "%preview.showMirrorButtons.description%"
        },
        "imageViewer.language": {
          "type": "string",
          "default": "auto",
          "scope": "application",
          "enum": [
            "auto",
            "en",
            "zh-CN",
            "zh-TW"
          ],
          "enumItemLabels": [
            "%language.follow%",
            "English",
            "简体中文",
            "繁體中文"
          ],
          "description": "%language.description%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "yarn run package",
    "native:build": "node scripts/build-imageio.cjs && node scripts/prepare-sharp.cjs",
    "native:package": "node scripts/build-imageio.cjs && node scripts/prepare-sharp.cjs --package",
    "test:sharp": "yarn native:build && node scripts/test-sharp.cjs",
    "test:thumbnail-native": "yarn compile && jest src/webviewController/imagesViewer/nativeTests --runInBand",
    "test:imageio": "yarn native:build && node scripts/test-imageio.cjs",
    "compile": "yarn native:build && npx webpack --config webpack.extension.js",
    "watch": "yarn native:build && npx webpack --config webpack.extension.js --watch",
    "package": "node scripts/package.cjs",
    "vsix": "bash scripts/vsix.sh",
    "vsix:all": "node scripts/vsix-platforms.cjs",
    "vsix:release": "node scripts/vsix-platforms.cjs --release",
    "publish:vscode": "node scripts/publish.cjs vscode",
    "publish:openvsx": "node scripts/publish.cjs openvsx",
    "publish:all": "node scripts/publish.cjs all",
    "release:check": "yarn check-type && yarn lint && yarn test:gallery && yarn test:resource-cache && yarn test:preview && yarn test:publish && yarn test:i18n",
    "release:verify": "node scripts/release-verify.cjs",
    "release:all": "yarn release:check && yarn vsix:release && yarn release:verify && yarn publish:all",
    "publish:check": "node scripts/publish.cjs check",
    "test:publish": "node --test scripts/publish.test.cjs",
    "openvsx:check": "node scripts/openvsx.cjs check",
    "openvsx:publish": "node scripts/openvsx.cjs publish",
    "test-compile": "tsc -p ./",
    "test-watch": "tsc -watch -p ./",
    "pretest": "yarn run test-compile && yarn run lint",
    "lint": "eslint src --ext ts,tsx",
    "test": "node ./out/test/runTest.js",
    "vendor:template": "node scripts/vendor-minimal-react-template.cjs",
    "ui-dev": "npx webpack serve --config scaffold/webview.webpack.js --color --progress --mode development",
    "ui-watch": "npx webpack --config scaffold/webview.webpack.js --watch --mode development",
    "ui-build": "npx webpack --config scaffold/webview.webpack.js --color --mode production",
    "lint-staged": "lint-staged",
    "check-type": "tsc --noEmit",
    "test:resource-cache": "jest src/webview/resourceCache --runInBand",
    "test:gallery": "jest src/folderFilterRules.test.ts src/feedback.test.ts src/webview/webviewPalette.test.ts src/webview/PreviewImages/gallery*.test.* src/webviewController/imagesViewer/*.test.ts --runInBand",
    "bench:thumb-mac": "node scripts/benchmark-ql-vs-jimp.cjs",
    "test:preview": "jest src/previewPreferencesHost.test.ts src/webview/usePreviewPreferences.test.tsx src/webview/previewPackage.test.tsx src/webview/useHostFullscreen.test.tsx src/windowFullscreen.test.ts src/webview/filmstripThumbnailStore.test.ts src/webview/useFilmstrip.test.tsx src/filmstripHost.test.ts src/webview/ShortcutHelp.test.tsx --runInBand",
    "bench:thumbnail-backends": "node scripts/benchmark-imageio-sharp.cjs",
    "test:i18n": "jest src/i18n src/webview/SingleImageViewer.test.tsx src/webview/notifications.test.tsx --runInBand"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ZhangJian1713/vscode-image-viewer.git"
  },
  "bugs": {
    "url": "https://github.com/ZhangJian1713/vscode-image-viewer/issues"
  },
  "devDependencies": {
    "@babel/core": "^7.14.8",
    "@babel/plugin-proposal-class-properties": "^7.14.5",
    "@babel/plugin-proposal-decorators": "^7.14.5",
    "@babel/plugin-proposal-private-methods": "^7.14.5",
    "@babel/plugin-proposal-private-property-in-object": "^7.14.5",
    "@babel/plugin-syntax-dynamic-import": "^7.8.3",
    "@babel/plugin-transform-runtime": "^7.14.5",
    "@babel/preset-env": "^7.14.8",
    "@babel/preset-react": "^7.14.5",
    "@babel/preset-typescript": "^7.14.5",
    "@babel/register": "^7.14.5",
    "@babel/runtime": "^7.29.10",
    "@commitlint/cli": "^12.1.4",
    "@svgr/webpack": "^5.5.0",
    "@testing-library/react-hooks": "^7.0.1",
    "@types/fs-extra": "^9.0.13",
    "@types/glob": "^7.1.3",
    "@types/jest": "^26.0.24",
    "@types/mocha": "^8.2.2",
    "@types/node": "14.x",
    "@types/react-router-dom": "^5.1.8",
    "@types/vscode": "^1.75.0",
    "@typescript-eslint/eslint-plugin": "^4.4.0",
    "@typescript-eslint/parser": "^4.4.0",
    "@vscode/vsce": "^3.7.1",
    "awesome-typescript-loader": "^5.2.1",
    "babel-loader": "^8.2.2",
    "babel-plugin-import": "^1.13.3",
    "clean-webpack-plugin": "^4.0.0-alpha.0",
    "connect-history-api-fallback": "^1.6.0",
    "conventional-changelog-conventionalcommits": "^4.6.0",
    "copy-webpack-plugin": "11.0.0",
    "css-loader": "^6.2.0",
    "eslint": "^7.31.0",
    "eslint-config-standard": "^16.0.3",
    "eslint-import-resolver-typescript": "^2.4.0",
    "eslint-plugin-cypress": "^2.11.3",
    "eslint-plugin-import": "^2.23.4",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^5.1.0",
    "eslint-plugin-react": "^7.32.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-standard": "^5.0.0",
    "fork-ts-checker-webpack-plugin": "4.1.6",
    "glob": "^7.1.7",
    "html-webpack-plugin": "^5.3.2",
    "husky": "4.2.3",
    "jest": "^27.0.6",
    "jimp": "0.22.12",
    "less": "^4.1.1",
    "less-loader": "^10.0.1",
    "lint-staged": "^11.0.1",
    "mini-css-extract-plugin": "^2.1.0",
    "mocha": "^8.4.0",
    "ovsx": "1.1.1",
    "prettier": "^2.3.2",
    "prettier-eslint-cli": "^5.0.1",
    "progress-bar-webpack-plugin": "^2.1.0",
    "react-docgen-typescript-loader": "^3.7.2",
    "react-hot-loader": "^4.13.0",
    "source-map-loader": "^3.0.0",
    "speed-measure-webpack-plugin": "^1.5.0",
    "style-loader": "^3.2.1",
    "terser-webpack-plugin": "^5.1.4",
    "ts-jest": "^27.0.4",
    "ts-loader": "^9.2.3",
    "typedoc": "^0.21.4",
    "typedoc-chd-theme": "^1.0.0",
    "typedoc-plugin-external-module-name": "^4.0.6",
    "typedoc-plugin-markdown": "^3.10.4",
    "typedoc-plugin-sourcefile-url": "^1.0.6",
    "typedoc-webpack-plugin": "^1.1.4",
    "typescript": "^4.3.5",
    "vscode-test": "^1.5.2",
    "webpack": "^5.45.1",
    "webpack-bundle-analyzer": "^4.4.2",
    "webpack-cli": "^4.7.2",
    "webpack-dev-server": "^3.11.2",
    "webpack-resolve-config-plugin": "^1.0.0"
  },
  "dependencies": {
    "@ant-design/icons": "^5.5.0",
    "@easy_vscode/core": "3.0.0",
    "@easy_vscode/webview": "2.0.2",
    "antd": "^5.22.0",
    "clipboard": "^2.0.8",
    "fs-extra": "^10.0.0",
    "i18next": "^21.9.0",
    "image-size": "2.0.4",
    "json5": "^2.2.3",
    "picomatch": "4.0.7",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "react-i18next": "^11.18.3",
    "right-image-preview": "0.9.0",
    "sharp": "0.35.5"
  },
  "resolutions": {
    "webpack": "5.73.0",
    "rc-util": "5.44.4"
  },
  "jest": {
    "moduleNameMapper": {
      "^react$": "<rootDir>/node_modules/react",
      "^react/(.*)$": "<rootDir>/node_modules/react/$1",
      "^react-dom$": "<rootDir>/node_modules/react-dom",
      "^react-dom/(.*)$": "<rootDir>/node_modules/react-dom/$1"
    }
  }
}
