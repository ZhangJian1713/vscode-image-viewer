{
  "compilerOptions": {
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "declaration": true,
    "lib": [
      "es5",
      "es2015",
      "es2016",
      "es2017",
      "dom"
    ],
    "module": "commonjs",
    "moduleResolution": "node",
    "noImplicitAny": false,
    "outDir": "./dist",
    "preserveConstEnums": true,
    "removeComments": true,
    "baseUrl": "src",
    "rootDirs": [
      "src"
    ],
    "jsx": "react",
    "sourceMap": true,
    "strictNullChecks": false,
    "target": "es6",
    "skipLibCheck": true,
    "importHelpers": true,
    "noEmit": false,
    "allowSyntheticDefaultImports": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "paths": {
      "react": [
        "../node_modules/@types/react"
      ],
      "react/*": [
        "../node_modules/@types/react/*"
      ],
      "react-dom": [
        "../node_modules/@types/react-dom"
      ],
      "react-dom/*": [
        "../node_modules/@types/react-dom/*"
      ]
    }
  },
  "exclude": [
    "dist"
  ],
  "include": [
    "src/**/*",
    "index.d.ts"
  ]
}
